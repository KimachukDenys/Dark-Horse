// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id           Int    @id @default(autoincrement())
  name         String @unique 

  wallet       Wallet?
  transactions ItemTransaction[]

  sourceMarket Goal[] @relation("GoalSourceMarket")
  targetMarket Goal[] @relation("GoalTargetMarket")
}

enum Currency {
  USD
  UAH
  EUR
}

model Wallet {
  id            Int @id @default(autoincrement())
  balance       Decimal  @db.Decimal(18, 6)
  currency      Currency @default(USD)
  market        Market @relation(fields: [marketId], references: [id])
  marketId      Int    @unique
}

model Item {
  id            Int @id @default(autoincrement())
  name          String @unique
  marketHashName      String @unique
  marketBucketGroupId       String?
  imageUrl                  String?
  itemColor                 String?
  backgroundColor           String?
  classId                   String?
  appId                     Int?

  itemType                  String?
  itemTypeIterName          String?
  
  weaponType                String?
  weaponTypeIterName        String?
  
  collection            String?
  collectionIterName    String?
  
  quality               String?
  qualityIterName       String?
  
  rarity                String?
  rarityIterName        String?
  
  exterior              String?
  exteriorIterName      String?
  
  transactions  ItemTransaction[]
}

enum TransactionType {
  BUY
  SELL
}

enum Wear {
  FN
  MW
  FT
  WW
  BS
  NONE
}

enum Status {
  PENDING
  INVENTORY
  LISTING
  SOLD
}

model ItemTransaction {
  id Int @id @default(autoincrement())

  floatValue Decimal     @db.Decimal(18, 14)

  price           Decimal         @db.Decimal(18, 2)
  type            TransactionType @default(BUY)
  quantity        Int
  itemStatus      Status          @default(PENDING)
  itemCurrency    Currency        @default(USD)
  roi             Decimal?        @db.Decimal(10, 4)

  csFloatId       String?
  steamAssetId    String?
  steamInstanceId String?

  market   Market @relation(fields: [marketId], references: [id])
  marketId Int

  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  sourceBuy ItemTransaction? @relation("BuySell", fields: [sourceBuyId], references: [id])
  sells ItemTransaction[] @relation("BuySell")
  sourceBuyId Int?

  createdAt DateTime @default(now())
  acquiredAt    DateTime
  tradeBanUntil DateTime?
  updatedAt DateTime @updatedAt

  goalTransaction GoalTransaction[]
}

enum GoalStatus {
  QUEUED
  ACTIVE
  COMPLETED
  CANCELED
}

model Goal {
  id Int @id @default(autoincrement())

  sourceMarketId    Int
  targetMarketId    Int
  status            GoalStatus @default(QUEUED)

  name             String
  description      String?
  targetInvestment Decimal @db.Decimal(18, 2)
  targetReceive    Decimal @db.Decimal(18, 2)
  targetSpend      Decimal? @db.Decimal(18, 2)
  targetReturn     Decimal? @db.Decimal(18, 2)
  roi              Decimal? @db.Decimal(10, 4)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  sourceMarket Market @relation("GoalSourceMarket", fields: [sourceMarketId], references: [id])
  targetMarket Market @relation("GoalTargetMarket", fields: [targetMarketId], references: [id])

  goalTransactions GoalTransaction[]
}

model GoalTransaction {
  id Int @id @default(autoincrement())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId Int

  transaction  ItemTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int


  @@unique([goalId, transactionId])
}
