// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_URL")
}

model User {
  id          Int @id @default(autoincrement())
  userName    String
  email       String @unique
  password    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemTransactions   ItemTransaction[]
  goals              Goal[]
  wallets            Wallet[]
}

model Market {
  id           Int    @id @default(autoincrement())
  name         String @unique 
  hashName     String @unique

  wallet       Wallet[]
}


model Wallet {
  //@@unique([marketId, steamUserId])
  id            Int      @id @default(autoincrement())
  balance       Decimal  @db.Decimal(28, 14)
  currency      CurrencyName @default(USD)
  market        Market   @relation(fields: [marketId], references: [id])
  marketId      Int      
  steamUserId   Int?
  transactions  ItemTransaction[]
  
  user          User      @relation(fields: [userId], references: [id])
  userId        Int

  sourceMarket Goal[] @relation("GoalSourceMarket")
  targetMarket Goal[] @relation("GoalTargetMarket")
}

model Currency {
  id      Int @id @default(autoincrement())
  name    String @unique
  currencyRate    Int
}


enum CurrencyName {
  USD
  UAH
  EUR
}

model Item {
  id            Int @id @default(autoincrement())
  name          String @unique
  marketHashName      String @unique
  marketBucketGroupId       String?
  imageUrl                  String?
  itemColor                 String?
  backgroundColor           String?
  classId                   String?
  appId                     Int?

  itemType                  String?
  itemTypeIterName          String?
  
  weaponType                String?
  weaponTypeIterName        String?
  
  collection            String?
  collectionIterName    String?
  
  quality               String?
  qualityIterName       String?
  
  rarity                String?
  rarityIterName        String?
  
  exterior              String?
  exteriorIterName      String?
  
  transactions          ItemTransaction[]
}

enum TransactionType {
  BUY
  SELL
}

enum Wear {
  FN
  MW
  FT
  WW
  BS
  NONE
}

enum Status {
  PENDING
  INVENTORY
  LISTING
  SOLD
}

model ItemTransaction {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int

  floatValue Decimal     @db.Decimal(26, 14)

  price           Decimal         @db.Decimal(26, 14)
  type            TransactionType @default(BUY)
  quantity        Int
  itemStatus      Status          @default(PENDING)
  itemCurrency    CurrencyName    @default(USD)
  roi             Decimal?        @db.Decimal(14, 4)

  csFloatId       String?
  steamAssetId    String?
  steamInstanceId String?

  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId Int

  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  sourceBuy ItemTransaction? @relation("BuySell", fields: [sourceBuyId], references: [id])
  sells ItemTransaction[] @relation("BuySell")
  sourceBuyId Int?

  createdAt DateTime @default(now())
  acquiredAt    DateTime
  tradeBanUntil DateTime?
  updatedAt DateTime @updatedAt

  goalTransaction GoalTransaction[]
}

enum GoalStatus {
  QUEUED
  ACTIVE
  COMPLETED
  CANCELED
}

model Goal {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int

  sourceWalletId    Int
  targetWalletId    Int
  status            GoalStatus @default(QUEUED)

  name             String
  description      String?
  targetInvestment Decimal @db.Decimal(26, 14)
  targetReceive    Decimal @db.Decimal(26, 14)
  targetSpend      Decimal? @db.Decimal(26, 14)
  targetReturn     Decimal? @db.Decimal(26, 14)
  roi              Decimal? @db.Decimal(14, 4)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  sourceWallet Wallet @relation("GoalSourceMarket", fields: [sourceWalletId], references: [id])
  targetWallet Wallet @relation("GoalTargetMarket", fields: [targetWalletId], references: [id])

  goalTransactions GoalTransaction[]
}

model GoalTransaction {
  id Int @id @default(autoincrement())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId Int

  transaction  ItemTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int


  @@unique([goalId, transactionId])
}
